{
  "manifest_version": 3,
  "name": "LingoLearn BN - Meaning & Pronunciation",
  "version": "1.1.4",
  "description": "Select any text to see its Bangla meaning and pronunciation - fully offline, no API, no tracking.",
  "author": "ANSNEW TECH.",
  "homepage_url": "https://inside.ansnew.com/",
  "minimum_chrome_version": "99",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common/settings.js",
        "content/styles.js",
        "content/popup-ui.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "LingoLearn BN",
    "default_popup": "action/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
